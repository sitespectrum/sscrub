{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5200"
      }
    }
  },

  "ConnectionStrings": {
    "SscrubDb": "Data Source=./data/db.sqlite3"
  },

  "Secrets": {
    "JwtKey": "very-secure-jwt-key"
  },

  "AssetStorageBucket": {
    "Region": "us-east-1",
    "Endpoint": "s3.eu-central-003.backblazeb2.com",
    "AccessKey": "some-access-key",
    "SecretKey": "so-secret",
    "Bucket": "my-bucket",
    "ProxyUrl": "proxy-url"
  },

  "AssetProxy": {
    "UrlSigningSecret": "very-secure-url-signing-secret",
    "BaseUrl": "https://sscrub-cf-b2-proxy.david-hcshu.workers.dev/presigned",
    "LifetimeSeconds": 7200
  }
}
